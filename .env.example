# Public base URL used in emails and share links
APP_URL=http://localhost:3000

# Where pdftek keeps its SQLite database and uploaded files
DATA_DIR=./data

# Claude API (powers Chat, Extract, Summaries, Compare insights, Automations)
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5. AI usage is billed to users in credits at this
# model's API price (see src/lib/billing.ts).
PDFTEK_AI_MODEL=

# Outbound email (signature requests, reminders, digests; also password resets when Supabase isn't used).
# Leave empty to log emails to the server console instead. Example (Resend):
# SMTP_URL=smtps://resend:YOUR_RESEND_API_KEY@smtp.resend.com:465
SMTP_URL=
MAIL_FROM="pdftek <no-reply@pdftek.app>"

# Sign-in with Supabase Auth (recommended): passwords, "Continue with Google", and the confirmation
# and password-reset emails are handled by Supabase. From Supabase: Project Settings > API.
# Without these, pdftek uses its own built-in email/password login.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional, server-only: moves accounts created before Supabase over on their next sign-in.
SUPABASE_SERVICE_ROLE_KEY=

# Payments (Day Pass, Pro, Team, credit packs). Prices are defined in src/lib/plans.ts, so no Stripe
# price IDs are needed. Webhook endpoint: /api/stripe/webhook with checkout.session.completed,
# invoice.paid, customer.subscription.updated and customer.subscription.deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated emails with unlimited use and free AI (the site owner).
ADMIN_EMAILS=

# Where messages from the /contact form are emailed (needs SMTP_URL). Defaults to the first ADMIN_EMAILS address.
# Every message is also saved in the contact_messages table.
CONTACT_EMAIL=

# Development only: purchases complete instantly without Stripe. Ignored in production.
PDFTEK_FAKE_PAYMENTS=

# Path to LibreOffice for Office -> PDF conversion on upload (auto-detected if on PATH)
SOFFICE_PATH=

# Search engines: the verification codes from Google Search Console and Bing Webmaster Tools
# (HTML tag method: paste only the content="..." value).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Website languages. pdftek translates its interface into 25 languages with the Anthropic API key
# above, once per piece of text, and stores the results in the database (re-deploys only translate
# new text). Set to 0 to switch translation off, or list languages to translate only some (e.g. es,fr).
PDFTEK_TRANSLATE=
PDFTEK_TRANSLATE_LOCALES=

# Translate PDF: model used for translations (defaults to a fast, lower-cost Claude model).
PDFTEK_TRANSLATE_MODEL=

# Payments through e-signature links go to each workspace owner's own Stripe account (Stripe
# Connect Express, enabled in your Stripe dashboard). Optional platform fee, in percent.
PDFTEK_PAYMENT_FEE_PERCENT=

# Cloud storage (Upload → From cloud, ⋯ → Save to cloud). Each service needs its own app; the
# redirect URL to register is https://YOUR_DOMAIN/api/cloud/<google|dropbox|onedrive>/callback.
#  Google Drive: OAuth client (Web) + API key with the Google Picker API enabled, scope drive.file.
#  GOOGLE_APP_ID is the Cloud project number (defaults to the first part of the client ID).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
#  Dropbox: app with scopes account_info.read, files.metadata.read, files.content.read, files.content.write.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
#  OneDrive: Microsoft Entra app (personal + work accounts) with Files.ReadWrite, User.Read, offline_access.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Tokens are encrypted at rest; the key is created on the data disk unless you set one here.
CLOUD_TOKEN_KEY=

# Email in: each workspace gets name-xxxx@INBOUND_EMAIL_DOMAIN. Point your inbound email service
# (Postmark, SendGrid Inbound Parse, Mailgun Routes or a Cloudflare Email Worker) at
# https://YOUR_DOMAIN/api/inbound/email?key=INBOUND_EMAIL_SECRET
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=

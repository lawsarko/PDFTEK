# Public base URL used in emails and share links
APP_URL=http://localhost:3000

# Where pdftek keeps its SQLite database and uploaded files
DATA_DIR=./data

# Claude API (powers Chat, Extract, Summaries, Compare insights, Automations)
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5
PDFTEK_AI_MODEL=claude-opus-5

# Outbound email (signature requests, document requests, reminders, digests).
# Leave empty to log emails to the server console instead.
SMTP_URL=
MAIL_FROM="pdftek <no-reply@pdftek.app>"

# Optional Stripe billing. Without these, workspace owners can start a 14-day Pro trial.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Path to LibreOffice for Office -> PDF conversion on upload (auto-detected if on PATH)
SOFFICE_PATH=

# Public base URL used in emails and share links
APP_URL=http://localhost:3000

# Where pdftek keeps its SQLite database and uploaded files
DATA_DIR=./data

# Claude API (powers Chat, Extract, Summaries, Compare insights, Automations)
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5. AI usage is billed to users in credits at this
# model's API price (see src/lib/billing.ts).
PDFTEK_AI_MODEL=

# Outbound email (signature requests, reminders, digests; also password resets when Supabase isn't used).
# Leave empty to log emails to the server console instead. Example (Resend):
# SMTP_URL=smtps://resend:YOUR_RESEND_API_KEY@smtp.resend.com:465
SMTP_URL=
MAIL_FROM="pdftek <no-reply@pdftek.app>"

# Sign-in with Supabase Auth (recommended): passwords, "Continue with Google", and the confirmation
# and password-reset emails are handled by Supabase. From Supabase: Project Settings > API.
# Without these, pdftek uses its own built-in email/password login.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional, server-only: moves accounts created before Supabase over on their next sign-in.
SUPABASE_SERVICE_ROLE_KEY=

# Payments (Day Pass, Pro, Team, credit packs). Prices are defined in src/lib/plans.ts, so no Stripe
# price IDs are needed. Webhook endpoint: /api/stripe/webhook with checkout.session.completed,
# invoice.paid, customer.subscription.updated and customer.subscription.deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated emails with unlimited use and free AI (the site owner).
ADMIN_EMAILS=

# Development only: purchases complete instantly without Stripe. Ignored in production.
PDFTEK_FAKE_PAYMENTS=

# Path to LibreOffice for Office -> PDF conversion on upload (auto-detected if on PATH)
SOFFICE_PATH=
